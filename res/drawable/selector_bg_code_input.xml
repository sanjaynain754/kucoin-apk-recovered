<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape>
            <stroke android:width="@dimen/line_width" android:color="@color/brandRed" />
            <corners android:radius="6.0dip" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape>
            <stroke android:width="@dimen/line_width" android:color="@color/brandGreen" />
            <corners android:radius="6.0dip" />
        </shape>
    </item>
    <item>
        <shape>
            <stroke android:width="@dimen/line_width" android:color="@color/c_cover12" />
            <corners android:radius="6.0dip" />
        </shape>
    </item>
</selector>