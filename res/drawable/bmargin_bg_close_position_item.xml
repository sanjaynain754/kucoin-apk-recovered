<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="8.0dip" />
                    <solid android:color="@color/primary4" />
                    <stroke android:width="@dimen/line_width" android:color="@color/primary" />
                </shape>
            </item>
            <item android:gravity="end|center" android:end="12.0dip">
                <bitmap android:src="@mipmap/kucoin_ic_checked" />
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="8.0dip" />
            <solid android:color="@color/c_cover2" />
        </shape>
    </item>
</selector>