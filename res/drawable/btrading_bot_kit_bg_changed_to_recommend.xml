<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="false">
        <shape android:shape="rectangle">
            <corners android:radius="5.0dip" />
            <gradient android:startColor="@color/emphasis4" android:endColor="@color/emphasis4" android:angle="0.0" />
        </shape>
    </item>
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <corners android:radius="5.0dip" />
            <gradient android:startColor="@color/primary20" android:endColor="@color/primary20" android:angle="0.0" />
            <stroke android:width="@dimen/line_width" android:color="@color/primary" />
            <padding android:left="@dimen/spacing_12" android:top="@dimen/spacing_12" android:right="@dimen/spacing_12" android:bottom="@dimen/spacing_12" />
        </shape>
    </item>
</selector>