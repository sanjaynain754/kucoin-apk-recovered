<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/size_22" />
            <gradient android:startColor="@color/primary12" android:endColor="@color/primary12" android:angle="0.0" />
        </shape>
    </item>
    <item android:state_pressed="false">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/size_22" />
            <gradient android:startColor="@color/emphasis4" android:endColor="@color/emphasis4" android:angle="0.0" />
        </shape>
    </item>
</selector>