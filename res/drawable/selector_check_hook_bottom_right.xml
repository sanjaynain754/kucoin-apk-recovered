<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <layer-list>
            <item>
                <shape>
                    <solid android:color="@color/primary4" />
                    <stroke android:width="0.5dip" android:color="@color/primary" />
                    <corners android:radius="8.0dip" />
                </shape>
            </item>
            <item android:gravity="bottom|center|right" android:drawable="@mipmap/ic_selected_check_hook_bottom_right" />
        </layer-list>
    </item>
    <item android:state_checked="false">
        <shape>
            <solid android:color="@color/c_cover2" />
            <corners android:radius="8.0dip" />
        </shape>
    </item>
</selector>