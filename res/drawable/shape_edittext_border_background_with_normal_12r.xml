<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape>
            <stroke android:width="1.0dip" android:color="@color/c_text" />
            <corners android:radius="12.0dip" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape>
            <stroke android:width="1.0dip" android:color="@color/c_text" />
            <corners android:radius="12.0dip" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <stroke android:width="1.0dip" android:color="@color/c_text" />
            <corners android:radius="12.0dip" />
        </shape>
    </item>
    <item android:state_checked="false" android:state_selected="false" android:state_activated="false">
        <shape>
            <stroke android:width="1.0dip" android:color="@color/c_divider8" />
            <corners android:radius="12.0dip" />
        </shape>
    </item>
</selector>