<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <layer-list>
            <item android:left="-1.0dip" android:top="-1.0dip" android:right="-1.0dip">
                <shape>
                    <solid android:color="@color/c_transparent" />
                    <stroke android:width="@dimen/line_width" android:color="@color/secondary" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_selected="true">
        <layer-list>
            <item android:left="-1.0dip" android:top="-1.0dip" android:right="-1.0dip">
                <shape>
                    <solid android:color="@color/c_transparent" />
                    <stroke android:width="@dimen/line_width" android:color="@color/primary" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:left="-1.0dip" android:top="-1.0dip" android:right="-1.0dip">
                <shape>
                    <solid android:color="@color/c_transparent" />
                    <stroke android:width="@dimen/line_width" android:color="@color/emphasis20" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>