<?xml version="1.0" encoding="utf-8"?>
<selector android:autoMirrored="true"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape>
                    <solid android:color="@color/emphasis8" />
                    <corners android:radius="4.0dip" />
                    <stroke android:width="@dimen/line_width" android:color="@color/secondary" />
                </shape>
            </item>
            <item android:right="1.0px" android:bottom="1.0px">
                <bitmap android:gravity="end|bottom|center" android:src="@mipmap/kucoin_icon_choose_label_secondary" />
            </item>
        </layer-list>
    </item>
    <item>
        <shape>
            <solid android:color="@color/emphasis8" />
            <corners android:radius="4.0dip" />
        </shape>
    </item>
</selector>