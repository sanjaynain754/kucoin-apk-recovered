<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <stroke android:width="1.0dip" android:color="@color/primary" />
                    <corners android:radius="4.0dip" />
                </shape>
            </item>
            <item android:gravity="bottom|center|right">
                <bitmap android:src="@mipmap/kucoin_icon_choose_label_round" />
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1.0dip" android:color="@color/emphasis20" />
            <corners android:radius="4.0dip" />
        </shape>
    </item>
</selector>