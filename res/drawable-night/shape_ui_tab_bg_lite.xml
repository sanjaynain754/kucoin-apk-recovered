<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/c_cover4" />
            <corners android:radius="24.0dip" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/c_cover4" />
            <corners android:radius="24.0dip" />
        </shape>
    </item>
    <item android:state_checked="false" android:state_selected="false" android:state_activated="false">
        <shape>
            <solid android:color="@color/c_cover8" />
            <corners android:radius="24.0dip" />
        </shape>
    </item>
</selector>